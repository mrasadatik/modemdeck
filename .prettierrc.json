{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "crlf",
  "insertPragma": false,
  "printWidth": 100,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": true,
  "singleAttributePerLine": false,
  "singleQuote": true,
  "svelteSortOrder": "scripts-markup-styles-options",
  "plugins": ["prettier-plugin-svelte"],
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
