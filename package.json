{
  "name": "@arculet-studios/modemdeck",
  "version": "1.0.0",
  "description": "Local-first web console for USB AT-command modems: SMS, USSD, call log, phonebook, network & dial-up data — private, self-hosted, localhost-only.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build",
    "dev:ui": "vite dev",
    "build:all": "npm run build && npm run build:ui",
    "format": "prettier --write \"src/**/*.ts\" \"frontend/**/*.{ts,svelte,css,js}\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"server.ts\" \"*.config.{js,ts}\" \"package.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"frontend/**/*.{ts,svelte,css,js}\" \"test/**/*.ts\" \"e2e/**/*.ts\" \"server.ts\" \"*.config.{js,ts}\" \"package.json\" \".prettierrc.json\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "start": "node dist/server.js",
    "test": "npm run build:all && node --test dist/test/*.test.js",
    "capture:trace": "npm run build && node dist/src/tools/capture-trace.js",
    "compatibility:report": "npm run build && node dist/src/tools/compatibility-report.js",
    "hardware:test": "npm run build && node dist/src/tools/hardware-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/svelte": "^1.1.5",
    "better-sqlite3": "^11.10.0",
    "libphonenumber-js": "^1.13.14",
    "selfsigned": "^5.5.0",
    "serialport": "^12.0.0"
  },
  "license": "MIT",
  "allowScripts": {
    "@serialport/bindings-cpp@12.0.1": true,
    "better-sqlite3@11.10.0": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
